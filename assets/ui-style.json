  "animations": {},
  "tokens": {
    "bg": "#1c2a22",
    "btn": "#2e3f34",
    "btn-border": "#4a5c50",
    "btn-hover": "#3a4f42",
    "card": "#1a2620",
    "danger": "#d84e2e",
    "danger-border": "#a85a4e",
    "dim": "#b8c8bc",
    "focus": "#f2c14e",
    "fuel": "#f2c14e",
    "panel": "#223028",
    "panel-border": "#3a4a40",
    "pedal": "#223028d9",
    "primary": "#2e7d4e",
    "primary-border": "#4ea872",
    "primary-hover": "#38925e",
