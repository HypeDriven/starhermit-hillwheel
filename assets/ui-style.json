        "focusRing": {
          "width": 3,
          "color": "$focus",
          "offset": 2
        }
      }
    },
    ".pedal-on": {
      "background": "$primary",
      "border": {
        "width": 2,
        "color": "$success",
        "style": "solid"
      },
      "radius": 14
    },
    ".pedal-hint": {
      "background": "$pedal",
      "border": {
        "width": 2,
        "color": "$fuel",
        "style": "solid"
      },
      "radius": 14
